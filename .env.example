# CCRIPT-Chatbot Environment Configuration
# Copy this file to .env and update with your actual values

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# STT (Speech-to-Text) Configuration
FASTER_WHISPER_MODEL=tiny
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE=int8

# TTS (Text-to-Speech) Configuration
PIPER_PATH=piper/piper.exe
PIPER_VOICE=en/en_US-amy-medium.onnx

# Database Configuration
DB_BACKEND=sqlite
# For MongoDB (optional): 
# DB_BACKEND=mongo
# MONGO_URI=mongodb://localhost:27017/ccript_chatbot

# Email Configuration for Password Reset
# SMTP Settings (required for email functionality)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=CCRIPT Agency

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:3000

# JWT Secret (generate a secure random string)
JWT_SECRET=your_super_secure_jwt_secret_here_change_this

# Security Settings
JWT_EXPIRE_MINUTES=60